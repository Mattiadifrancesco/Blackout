[2026.09.23-09.56.35:118][578]LogFabLauncher: Debug payload: [{"id":"47827bc6-d20b-4567-b6e1-4650f5bc8057","path":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/Low_Poly_Weapons_Set-47827bc6/fbx/separate_assets_fbx_extracted","meshes":[{"file":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/Low_Poly_Weapons_Set-47827bc6/fbx/separate_assets_fbx_extracted/Separate_assets_fbx/AssaultRifle_01.fbx","name":"","material_index":-1,"lods":[]},{"file":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/Low_Poly_Weapons_Set-47827bc6/fbx/separate_assets_fbx_extracted/Separate_assets_fbx/PumpShotgun_01.fbx","name":"","material_index":-1,"lods":[]},{"file":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/Low_Poly_Weapons_Set-47827bc6/fbx/separate_assets_fbx_extracted/Separate_assets_fbx/TacticalPistol_01.fbx","name":"","material_index":-1,"lods":[]}],"materials":[],"native_files":[],"additional_textures":[],"metadata":{"launcher":{"version":"0.0.1","listening_port":24563},"fab":{"assetNamespace":"fab","listing":{"averageRating":0,"createdAt":"","description":"<p><a target=\"_blank\" href=\"https://discord.gg/wfZeU5bzTf\" rel=\"noopener noreferrer nofollow\"><strong>MR POLY Discord Hub</strong></a></p><p>Discover new 3D assets, get tips &amp; tricks, and be part of exclusive challenges and giveaways!</p><p></p><h5><span class=\"fabkit-prose-color--yellow\"><strong>MR POLY presents</strong></span></h5><h5>Low Poly Weapons Set</h5><p><br>Includes</p><p>● <span>3 Low Poly Weapons</span></p><p>● <span>Separate Triggers &amp; Magazines</span><br></p><p></p><p><span>🔫 Create stylized and optimized shooter experiences with this <strong>Low Poly Weapon Set</strong>.</span></p><p><span>Designed for FPS, TPS, tactical, survival, mobile, VR, and stylized games, this pack includes three essential weapons: a Tactical Pistol, Assault Rifle, and Pump Shotgun.</span></p><p><span>Each weapon comes with multiple color variations and separate components such as triggers and magazines, making the assets suitable for animation, customization, and gameplay integration.</span></p><p></p><h5><span class=\"fabkit-prose-color--red\">Overview</span></h5><p><span>This package contains a collection of stylized low-poly weapons suitable for a wide range of game projects.</span></p><p><span>The included weapons are:</span></p><p></p><p><span>• Tactical Pistol</span><br><span>• Assault Rifle</span><br><span>• Pump Shotgun</span></p><p></p><p><span>The weapons feature separate triggers and magazines, providing additional flexibility for animation, customization, and gameplay setups.</span></p><p><span>The assets are designed with optimized geometry and a clean structure, making them suitable for performance-conscious projects including mobile and VR games.</span></p><p></p><h5><span class=\"fabkit-prose-color--red\">Key Features</span></h5><p><span>• <strong>3 Stylized Low Poly Weapons</strong></span></p><p><span>A Tactical Pistol, Assault Rifle, and Pump Shotgun designed for stylized and low-poly game projects.</span></p><p><span><strong>• Color Variants</strong></span></p><p><span>Multiple color variations provide flexibility for different characters, factions, teams, or gameplay styles.</span></p><p><span><strong>• Separate Weapon Components</strong></span></p><p><span>Triggers and magazines are separated from the main weapon meshes, allowing for easier animation and customization.</span></p><p><span><strong>• Optimized for Real-Time Projects</strong></span></p><p><span>Lightweight low-poly geometry makes the assets suitable for performance-conscious games and real-time applications.</span></p><p><span><strong>• Versatile Game Applications</strong></span></p><p><span>Ideal for FPS, TPS, tactical, survival, action, mobile, VR, and stylized games.</span></p><p><span><strong>• Consistent Stylized Design</strong></span></p><p><span>All weapons share a consistent low-poly visual style, making them easy to combine within the same project.</span></p><p><span><strong>• Organized Asset Structure</strong></span></p><p><span>Assets are organized into clearly named folders for easy navigation and efficient workflow.</span></p><p></p><h5><span class=\"fabkit-prose-color--red\">Support</span></h5><p>📧 <strong>Email:</strong> MrPolyStudio@gmail.com</p><p>We actively improve our assets and appreciate your feedback.</p><p>If you enjoy this package, please consider leaving a review, it helps support future updates and new asset packs.</p><p></p><p><br>Keep track of our latest releases, tutorials, and special offers:</p><p>🌐 <a target=\"_blank\" href=\"https://discord.gg/wfZeU5bzTf\" rel=\"noopener noreferrer nofollow\"><strong>Discord </strong></a><strong>| </strong><a target=\"_blank\" href=\"https://www.reddit.com/user/Individual_Union8181/\" rel=\"noopener noreferrer nofollow\"><strong>Reddit </strong></a><strong>| </strong><a target=\"_blank\" href=\"https://www.youtube.com/@mrpolystudio\" rel=\"noopener noreferrer nofollow\"><strong>YouTube</strong></a></p>","isAiForbidden":true,"isAiGenerated":false,"lastUpdatedAt":"","listingType":"3d-model","media":"https://media.fab.com/image_previews/gallery_images/5e7c86e1-19c5-4476-958d-b62a3f8687ef/f1b0477a-8768-47f6-a7a3-65fa229ffc4f.jpg","publishedAt":"2026-09-02T13:15:59.252537Z","reviewCount":0,"thumbnail":"https://media.fab.com/image_previews/gallery_images/114d9372-10ca-4ffc-bb3f-2263b57d6036/93605fca-05ce-4090-9f8f-d9db7bdd9011.jpg","title":"Low Poly Weapons Set","uid":"47827bc6-d20b-4567-b6e1-4650f5bc8057","updatedAt":"","user":{"coverImageUrl":"https://cdn1.epicgames.com/fab/seller/o-azvcg3zgdbctk4hq3fzq5vdmkj64zp/cover/a7bac710.jpg","profileImageUrl":"https://cdn1.epicgames.com/fab/seller/o-azvcg3zgdbctk4hq3fzq5vdmkj64zp/profile/fc7b2da2.png","sellerName":"MR POLY","uid":"bd185e3c-6e9b-4530-84bb-40306a0a6b54"},"tags":[{"name":"Fps","slug":"fps","uid":"14fc2ff6-5e86-46c6-a1f1-668f1de87697"},{"name":"Survival","slug":"survival","uid":"1bccf364-5fcd